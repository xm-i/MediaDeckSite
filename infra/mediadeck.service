[Unit]
Description=MediaDeck Site Service
After=network.target

[Service]
WorkingDirectory=/opt/mediadeck.xm-i.net
ExecStart=/opt/dotnet10/dotnet /opt/mediadeck.xm-i.net/MediaDeckSite.dll --urls=http://0.0.0.0:5001 --environment=Production
Restart=always
RestartSec=5
SyslogIdentifier=mediadeck
User=deploy
Environment=ASPNETCORE_URLS=http://0.0.0.0:5001
Environment=DOTNET_ROOT=/opt/dotnet10
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false

[Install]
WantedBy=multi-user.target
